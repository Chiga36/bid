# Leave both unset for the default (recommended): the frontend derives the backend URL from
# whatever host it was itself loaded from (window.location.hostname) plus VITE_API_PORT
# (defaulting to 5000) — this works whether you open it via localhost, 127.0.0.1, or another
# device's LAN IP, with no rebuild needed when that changes. Only set VITE_API_BASE_URL if the
# backend lives on a genuinely different host than the frontend (a real deployment) — it always
# wins outright over the derived URL when set.
# VITE_API_BASE_URL=http://127.0.0.1:5000
# VITE_API_PORT=5000
