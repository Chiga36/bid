API_BACKEND_PORT=5000
API_BACKEND_HOST=127.0.0.1
API_PAYLOAD_MAX_SIZE=10mb

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# Only required when using API-key authentication locally
AZURE_OPENAI_API_KEY=

# Path to the SQLite database file, created automatically on first run
DATABASE_PATH=./bid_coauthor.db
